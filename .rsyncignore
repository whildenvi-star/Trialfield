node_modules
.next
.git
.planning
.vercel

# CRITICAL: Never overwrite production data with local data
# With-prefix: protects when syncing from project root (farm-budget/data/data.json)
*/data/data.json
*/data/data.json.bak.*
*/data/photos
# Bare: protects when syncing a single app subdirectory (data/data.json)
data/data.json
data/data.json.bak.*
data/photos

# Droplet-side rotation writes data.json.bak-<label>-<ISO>, with a HYPHEN after
# "bak" — the data.json.bak.* patterns above use a dot and do not match it, so
# --delete was removing production snapshots that exist only on the droplet.
*/data/data.json.bak-*
data/data.json.bak-*

# Uploaded invoice/contract originals + their ledger. Written on the droplet by
# document intake; the local tree holds only a .gitignore, so without this
# --delete would wipe the evidence behind every confirmed pass.
*/data/documents
data/documents

# Generated on the droplet by a backfill run; no local counterpart to sync.
*/backfill-crop-report.json
backfill-crop-report.json

# Previous build kept on the droplet as a rollback copy (379MB). .next is
# already excluded above, but .next.old is not covered by that pattern.
.next.old

# Droplet-side data snapshots and generated files — never delete/overwrite
*/data/data.json.pre-*
data/data.json.pre-*
*/data/audit-results.json
data/audit-results.json
*/data/chat-log.jsonl
data/chat-log.jsonl
*/data/chat-usage.json
data/chat-usage.json

# Environment files
*.env
.env.*
